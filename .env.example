# Redis connection URL (required)
REDIS_URL=redis://localhost:6379/0

# Bearer token to protect the API (optional; auth is disabled when unset)
#API_TOKEN=your-secret-token

# Address and port to listen on (optional; defaults to 0.0.0.0:8888)
#LISTEN_ADDR=0.0.0.0:8888

# Skill ID that /alexa requests must name (optional; any skill is accepted when unset)
#ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
